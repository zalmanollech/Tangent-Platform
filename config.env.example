# Traidefi Configuration Template
# Copy this file to config.env and fill in your actual values
# NEVER commit config.env to Git!

# Server Configuration
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Security (CHANGE THESE IN PRODUCTION!)
JWT_SECRET=your_jwt_secret_here_change_in_production
ADMIN_KEY=your_admin_key_here_change_in_production
BCRYPT_ROUNDS=12

# Database Configuration
# Supabase Session Pooler - Use this for server applications
DATABASE_URL=postgresql://postgres.xxxxx:password@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres
DB_MAX_CONNECTIONS=10
DB_SSL=true

# Storage Configuration (for PDF reports)
STORAGE_TYPE=supabase
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here
SUPABASE_BUCKET=traidefi-reports

# Email Configuration
EMAIL_PROVIDER=resend
FROM_EMAIL=noreply@traidefi.ai
FROM_NAME=Traidefi
BASE_URL=https://traidefi.ai

# Resend Configuration
RESEND_API_KEY=your_resend_api_key_here

# PayPal Configuration
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CURRENCY=USD

# Credit Bureau API Configuration
# Dun & Bradstreet API
DNB_API_KEY=your_dnb_api_key_here
DNB_API_SECRET=your_dnb_api_secret_here
DNB_BASE_URL=https://direct.dnb.com

# Experian Business Credit API
EXPERIAN_API_KEY=your_experian_api_key_here
EXPERIAN_API_SECRET=your_experian_api_secret_here
EXPERIAN_BASE_URL=https://api.experian.com/businesscredit

# Equifax Business Credit API
EQUIFAX_API_KEY=your_equifax_api_key_here
EQUIFAX_API_SECRET=your_equifax_api_secret_here
EQUIFAX_BASE_URL=https://api.equifax.com/business/v1

# Credit Service Configuration
CREDIT_SERVICE_URL=http://localhost:8001
INSURANCE_SERVICE_URL=http://localhost:8002

# Blockchain Configuration (Sepolia Testnet)
SEPOLIA_RPC_URL=your_sepolia_rpc_url_here
BLOCKCHAIN_ENABLED=true
BLOCKCHAIN_NETWORK=sepolia
SEPOLIA_PRIVATE_KEY=your_private_key_here
TGT_ADDRESS=your_tgt_contract_address_here
ESCROW_ADDRESS=your_escrow_contract_address_here

